{
  "name": "musuw-app-edge",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "assets:stage": "node scripts/stage-assets.mjs",
    "bundle:check": "node scripts/verify-bundle.mjs",
    "config:check": "node scripts/verify-config.mjs",
    "workflow:check": "node scripts/verify-workflow.mjs",
    "types": "wrangler types",
    "test": "npm run types && vitest run",
    "typecheck": "npm run types && tsc --noEmit",
    "dry-run": "npm run assets:stage && npm run config:check && npm run types && wrangler deploy --env staging --dry-run"
  },
  "devDependencies": {
    "typescript": "6.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.118.0"
  }
}
