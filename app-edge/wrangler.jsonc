{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "musuw-app",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ORIGIN_APP_URL": "https://origin-app.musuw.com"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "env": {
    "staging": {
      "name": "musuw-app-staging",
      "workers_dev": true,
      "preview_urls": true,
      "vars": {
        "ORIGIN_APP_URL": "https://origin-app.musuw.com"
      }
    },
    "production": {
      "name": "musuw-app",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "app.musuw.com/*",
          "zone_name": "musuw.com"
        }
      ],
      "vars": {
        "ORIGIN_APP_URL": "https://origin-app.musuw.com"
      }
    }
  }
}

