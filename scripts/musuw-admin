#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
runtime_dir="$repo_root/.runtime/musuw-admin"
pid_file="$runtime_dir/server.pid"
target_file="$runtime_dir/target"
log_file="$runtime_dir/server.log"
tunnel_target_file="$runtime_dir/production-tunnel-target"
tunnel_port_file="$runtime_dir/production-tunnel-port"
server_script="$repo_root/scripts/musuw-admin-server.mjs"
listen_host=127.0.0.1
listen_port=4186
legacy_container=musuw-appsmith
production_tunnel_default_port=15433
production_remote_db_default_port=5432
production_container_default=weknora-v072-production-postgres
production_ssh_target_default=musuw-tokyo
admin_uid=$(id -u)
ssh_control_socket="/tmp/musuw-admin-ssh-${admin_uid}.sock"

usage() {
  cat <<'EOF'
Usage: scripts/musuw-admin test|production|stop|status|logs

  test        Build and start the source-controlled TEST operations console.
  production  Start against explicit production runtime config (locked).
  prepare-production-tunnel
              Prepare the existing pinned Tokyo SSH tunnel without restarting the console.
  stop        Stop the operations server. The retired Appsmith volume is preserved.
  status      Show the selected environment, process state, and loopback URL.
  logs        Show the last 100 server log lines.
EOF
}

die() {
  printf 'musuw-admin: %s\n' "$*" >&2
  exit 1
}

valid_port() {
  case "$1" in
    ''|*[!0-9]*) return 1 ;;
  esac
  [ "$1" -ge 1 ] 2>/dev/null && [ "$1" -le 65535 ] 2>/dev/null
}

safe_ssh_target() {
  case "$1" in
    ''|-*|*[!A-Za-z0-9._:@-]*) return 1 ;;
    *) return 0 ;;
  esac
}

safe_container_name() {
  case "$1" in
    ''|*[!A-Za-z0-9_.-]*) return 1 ;;
    *) return 0 ;;
  esac
}

resolve_production_ssh_target() {
  resolved_ssh_target=${MUSUW_ADMIN_PRODUCTION_SSH_TARGET:-$production_ssh_target_default}
  safe_ssh_target "$resolved_ssh_target" || die 'MUSUW_ADMIN_PRODUCTION_SSH_TARGET is unsafe'
  printf '%s' "$resolved_ssh_target"
}

resolve_production_container() {
  resolved_container=${MUSUW_ADMIN_PRODUCTION_CONTAINER:-$production_container_default}
  safe_container_name "$resolved_container" || die 'MUSUW_ADMIN_PRODUCTION_CONTAINER is unsafe'
  printf '%s' "$resolved_container"
}

production_runtime_value() {
  key=$1
  runtime_file="$runtime_dir/production.env"
  [ -r "$runtime_file" ] && [ ! -L "$runtime_file" ] || die 'production runtime is unavailable'
  value=$(awk -v wanted_key="$key" '
    /^[[:space:]]*($|#)/ { next }
    /^[[:space:]]*(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*=/ {
      line=$0
      sub(/^[[:space:]]*export[[:space:]]+/, "", line)
      split(line, fields, "=")
      if (fields[1] == wanted_key) {
        value=substr(line, index(line, "=") + 1)
        sub(/^[[:space:]]+/, "", value)
        sub(/[[:space:]]+$/, "", value)
        if (substr(value, 1, 1) == "\"" && substr(value, length(value), 1) == "\"") {
          value=substr(value, 2, length(value) - 2)
        }
        print value
        exit
      }
    }
  ' "$runtime_file")
  [ -n "$value" ] || die "production runtime is missing $key"
  printf '%s' "$value"
}

production_database_url_port() {
  url=$1
  authority=${url#*://}
  authority=${authority%%/*}
  authority=${authority##*@}
  case "$authority" in
    \[*\]:*) port=${authority##*]:} ;;
    *:*) port=${authority##*:} ;;
    *) port='' ;;
  esac
  valid_port "$port" && printf '%s' "$port"
}

production_tunnel_port() {
  configured_port=${MUSUW_ADMIN_PRODUCTION_TUNNEL_PORT:-}
  if [ -n "$configured_port" ]; then
    valid_port "$configured_port" || die 'MUSUW_ADMIN_PRODUCTION_TUNNEL_PORT is invalid'
    printf '%s' "$configured_port"
    return
  fi
  database_url=$(production_runtime_value MUSUW_ADMIN_DATABASE_URL)
  database_url_port=$(production_database_url_port "$database_url" || true)
  if [ -n "$database_url_port" ]; then
    printf '%s' "$database_url_port"
  else
    printf '%s' "$production_tunnel_default_port"
  fi
}

production_remote_db_port() {
  configured_port=${MUSUW_ADMIN_PRODUCTION_DB_PORT:-$production_remote_db_default_port}
  valid_port "$configured_port" || die 'MUSUW_ADMIN_PRODUCTION_DB_PORT is invalid'
  printf '%s' "$configured_port"
}

server_pid() {
  [ -r "$pid_file" ] || return 1
  pid=$(sed -n '1p' "$pid_file")
  case "$pid" in
    ''|*[!0-9]*) return 1 ;;
  esac
  command_line=$(ps -p "$pid" -o command= 2>/dev/null || true)
  case "$command_line" in
    *musuw-admin-server.mjs*) printf '%s\n' "$pid" ;;
    *) return 1 ;;
  esac
}

stop_server() {
  if pid=$(server_pid); then
    kill "$pid" 2>/dev/null || true
    attempt=0
    while kill -0 "$pid" 2>/dev/null && [ "$attempt" -lt 40 ]; do
      attempt=$((attempt + 1))
      sleep 0.1
    done
    if kill -0 "$pid" 2>/dev/null; then
      kill -KILL "$pid" 2>/dev/null || true
    fi
  fi
  rm -f "$pid_file" "$target_file"
}

retire_appsmith() {
  command -v docker >/dev/null 2>&1 || return 0
  docker info >/dev/null 2>&1 || return 0
  if docker inspect "$legacy_container" >/dev/null 2>&1; then
    state=$(docker inspect "$legacy_container" --format '{{.State.Running}}' 2>/dev/null || true)
    if [ "$state" = true ]; then
      docker stop "$legacy_container" >/dev/null
    fi
    docker rm "$legacy_container" >/dev/null
  fi
}

port_is_busy() {
  command -v lsof >/dev/null 2>&1 || return 1
  lsof -nP -iTCP:"$listen_port" -sTCP:LISTEN >/dev/null 2>&1
}

tcp_port_is_busy() {
  command -v lsof >/dev/null 2>&1 || return 1
  lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command is unavailable: $1"
}

wait_for_tunnel_port() {
  tunnel_port=$1
  attempt=0
  while [ "$attempt" -lt 150 ]; do
    if nc -z -w 1 127.0.0.1 "$tunnel_port" >/dev/null 2>&1; then
      return 0
    fi
    attempt=$((attempt + 1))
    sleep 0.1
  done
  return 1
}

require_pinned_ssh_target() {
  ssh_target_arg=$1
  ssh_config=$(ssh -o BatchMode=yes -o StrictHostKeyChecking=yes -G "$ssh_target_arg" 2>/dev/null) || \
    die 'production SSH target is not a usable pinned alias'
  resolved_user=$(printf '%s\n' "$ssh_config" | awk '$1 == "user" { print $2; exit }')
  resolved_host=$(printf '%s\n' "$ssh_config" | awk '$1 == "hostname" { print $2; exit }')
  strict_host_key=$(printf '%s\n' "$ssh_config" | awk '$1 == "stricthostkeychecking" { print $2; exit }')
  known_hosts_file=$(printf '%s\n' "$ssh_config" | awk '$1 == "userknownhostsfile" { print $2; exit }')
  [ -n "$resolved_user" ] && [ -n "$resolved_host" ] && [ -n "$known_hosts_file" ] || \
    die 'production SSH target is missing pinned host configuration'
  [ "$resolved_user" != root ] || die 'production SSH target must use the restricted operator account'
  case "$strict_host_key" in
    yes|true) : ;;
    *) die 'production SSH target must require strict host-key checking' ;;
  esac
}

discover_production_container_ip() {
  ssh_target_arg=$1
  container_arg=$2
  container_ip=$(ssh \
    -o BatchMode=yes \
    -o StrictHostKeyChecking=yes \
    -o ConnectTimeout=10 \
    "$ssh_target_arg" \
    "sudo -n docker inspect --format '{{range .NetworkSettings.Networks}}{{println .IPAddress}}{{end}}' $container_arg" \
    2>/dev/null | awk 'NF { print; exit }')
  [ -n "$container_ip" ] || die 'cannot inspect production PostgreSQL; verify the pinned SSH alias, sudo rule and known_hosts entry'
  printf '%s\n' "$container_ip" | awk -F. '
    NF == 4 {
      for (i = 1; i <= 4; i++) {
        if ($i !~ /^[0-9][0-9]*$/ || length($i) > 3 || $i > 255) exit 1
      }
      ok = 1
    }
    END { exit(ok ? 0 : 1) }
  ' >/dev/null 2>&1 || die 'production PostgreSQL container returned an invalid IPv4 address'
  printf '%s' "$container_ip"
}

stop_tunnel() {
  tunnel_target=''
  if [ -r "$tunnel_target_file" ]; then
    tunnel_target=$(tr -d '\r\n' < "$tunnel_target_file")
  fi
  if [ -S "$ssh_control_socket" ] && safe_ssh_target "$tunnel_target" && command -v ssh >/dev/null 2>&1; then
    ssh -o BatchMode=yes -o StrictHostKeyChecking=yes -S "$ssh_control_socket" -O exit "$tunnel_target" >/dev/null 2>&1 || true
  fi
  rm -f "$ssh_control_socket" "$tunnel_target_file" "$tunnel_port_file"
}

prepare_production_tunnel() {
  validate_target production
  require_command ssh
  require_command lsof
  require_command nc
  mkdir -p "$runtime_dir"

  tunnel_port=$(production_tunnel_port)
  remote_db_port=$(production_remote_db_port)
  ssh_target=$(resolve_production_ssh_target)
  container=$(resolve_production_container)

  if tcp_port_is_busy "$tunnel_port"; then
    existing_port=''
    if [ -r "$tunnel_port_file" ]; then
      existing_port=$(tr -d '\r\n' < "$tunnel_port_file")
    fi
    if [ "$existing_port" = "$tunnel_port" ] && [ -S "$ssh_control_socket" ] && \
      ssh -o BatchMode=yes -o StrictHostKeyChecking=yes -S "$ssh_control_socket" -O check "$ssh_target" >/dev/null 2>&1; then
      # A local listener is not enough to establish production identity.  Even
      # a previously recorded socket must still resolve to the pinned
      # alias and expose the expected production PostgreSQL container before
      # it is reused as our tunnel.
      require_pinned_ssh_target "$ssh_target"
      discover_production_container_ip "$ssh_target" "$container" >/dev/null
      return 0
    fi
    die "production tunnel port ${tunnel_port} is already in use"
  fi

  rm -f "$ssh_control_socket"
  require_pinned_ssh_target "$ssh_target"
  container_ip=$(discover_production_container_ip "$ssh_target" "$container")
  ssh \
    -o BatchMode=yes \
    -o StrictHostKeyChecking=yes \
    -o ConnectTimeout=10 \
    -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=3 \
    -o ExitOnForwardFailure=yes \
    -M -S "$ssh_control_socket" -f -N \
    -L "127.0.0.1:${tunnel_port}:${container_ip}:${remote_db_port}" \
    "$ssh_target" >/dev/null 2>&1 || {
      rm -f "$ssh_control_socket"
      die 'production SSH tunnel could not be started; verify the pinned SSH alias and known_hosts entry'
    }
  printf '%s\n' "$ssh_target" > "$tunnel_target_file"
  printf '%s\n' "$tunnel_port" > "$tunnel_port_file"
  if ! wait_for_tunnel_port "$tunnel_port"; then
    stop_tunnel
    die 'production SSH tunnel did not become ready'
  fi
}

tunnel_status() {
  tunnel_target=''
  tunnel_port=''
  if [ -r "$tunnel_target_file" ]; then
    tunnel_target=$(tr -d '\r\n' < "$tunnel_target_file")
  fi
  if [ -r "$tunnel_port_file" ]; then
    tunnel_port=$(tr -d '\r\n' < "$tunnel_port_file")
  fi
  if [ -S "$ssh_control_socket" ] && safe_ssh_target "$tunnel_target" && valid_port "$tunnel_port" && \
    command -v ssh >/dev/null 2>&1 && ssh -o BatchMode=yes -o StrictHostKeyChecking=yes -S "$ssh_control_socket" -O check "$tunnel_target" >/dev/null 2>&1; then
    printf 'running'
  else
    printf 'stopped'
  fi
}

wait_for_health() {
  attempt=0
  while [ "$attempt" -lt 100 ]; do
    if curl --fail --silent --max-time 1 "http://$listen_host:$listen_port/healthz" >/dev/null 2>&1; then
      return 0
    fi
    if ! server_pid >/dev/null 2>&1; then
      return 1
    fi
    attempt=$((attempt + 1))
    sleep 0.1
  done
  return 1
}

run_with_runtime_env() {
  runtime_target=$1
  shift
  replace_process=no
  if [ "${1:-}" = '--replace-process' ]; then
    replace_process=yes
    shift
  fi
  # The selected runtime file and Keychain are the only authorities for
  # database/provider credentials. Keep the launcher environment deliberately
  # small so a shell export from the other target cannot cross a restart.
  if [ "$runtime_target" = test ]; then
    if [ "$replace_process" = yes ]; then
      exec env -i \
        "PATH=${PATH:-/usr/bin:/bin:/usr/sbin:/sbin}" \
        "HOME=${HOME:-/tmp}" \
        "MUSUW_ADMIN_PORT=$listen_port" \
        "MUSUW_ADMIN_TEST_DB_HOST=${MUSUW_ADMIN_TEST_DB_HOST:-}" \
        "MUSUW_ADMIN_TEST_DB_PORT=${MUSUW_ADMIN_TEST_DB_PORT:-}" \
        "MUSUW_ADMIN_TEST_BACKEND_URL=${MUSUW_ADMIN_TEST_BACKEND_URL:-}" \
        "MUSUW_ADMIN_PRODUCTION_SSH_TARGET=${MUSUW_ADMIN_PRODUCTION_SSH_TARGET:-}" \
        "MUSUW_ADMIN_PRODUCTION_TUNNEL_PORT=${MUSUW_ADMIN_PRODUCTION_TUNNEL_PORT:-}" \
        "MUSUW_ADMIN_PRODUCTION_DB_PORT=${MUSUW_ADMIN_PRODUCTION_DB_PORT:-}" \
        "MUSUW_ADMIN_PRODUCTION_CONTAINER=${MUSUW_ADMIN_PRODUCTION_CONTAINER:-}" \
        "MUSUW_R2_ACCOUNT_ID=${MUSUW_R2_ACCOUNT_ID:-}" \
        "MUSUW_R2_TEST_BUCKET=${MUSUW_R2_TEST_BUCKET:-}" \
        "MUSUW_R2_PREFIX=${MUSUW_R2_PREFIX:-}" \
        "MUSUW_LANGFUSE_HOST=${MUSUW_LANGFUSE_HOST:-}" \
        "$@"
    fi
    env -i \
      "PATH=${PATH:-/usr/bin:/bin:/usr/sbin:/sbin}" \
      "HOME=${HOME:-/tmp}" \
      "MUSUW_ADMIN_PORT=$listen_port" \
      "MUSUW_ADMIN_TEST_DB_HOST=${MUSUW_ADMIN_TEST_DB_HOST:-}" \
      "MUSUW_ADMIN_TEST_DB_PORT=${MUSUW_ADMIN_TEST_DB_PORT:-}" \
      "MUSUW_ADMIN_TEST_BACKEND_URL=${MUSUW_ADMIN_TEST_BACKEND_URL:-}" \
      "MUSUW_ADMIN_PRODUCTION_SSH_TARGET=${MUSUW_ADMIN_PRODUCTION_SSH_TARGET:-}" \
      "MUSUW_ADMIN_PRODUCTION_TUNNEL_PORT=${MUSUW_ADMIN_PRODUCTION_TUNNEL_PORT:-}" \
      "MUSUW_ADMIN_PRODUCTION_DB_PORT=${MUSUW_ADMIN_PRODUCTION_DB_PORT:-}" \
      "MUSUW_ADMIN_PRODUCTION_CONTAINER=${MUSUW_ADMIN_PRODUCTION_CONTAINER:-}" \
      "MUSUW_R2_ACCOUNT_ID=${MUSUW_R2_ACCOUNT_ID:-}" \
      "MUSUW_R2_TEST_BUCKET=${MUSUW_R2_TEST_BUCKET:-}" \
      "MUSUW_R2_PREFIX=${MUSUW_R2_PREFIX:-}" \
      "MUSUW_LANGFUSE_HOST=${MUSUW_LANGFUSE_HOST:-}" \
      "$@"
    return
  fi
  if [ "$replace_process" = yes ]; then
    exec env -i \
      "PATH=${PATH:-/usr/bin:/bin:/usr/sbin:/sbin}" \
      "HOME=${HOME:-/tmp}" \
      "MUSUW_ADMIN_PORT=$listen_port" \
      "MUSUW_ADMIN_PRODUCTION_SSH_TARGET=${MUSUW_ADMIN_PRODUCTION_SSH_TARGET:-}" \
      "MUSUW_ADMIN_PRODUCTION_TUNNEL_PORT=${MUSUW_ADMIN_PRODUCTION_TUNNEL_PORT:-}" \
      "MUSUW_ADMIN_PRODUCTION_DB_PORT=${MUSUW_ADMIN_PRODUCTION_DB_PORT:-}" \
      "MUSUW_ADMIN_PRODUCTION_CONTAINER=${MUSUW_ADMIN_PRODUCTION_CONTAINER:-}" \
      "$@"
  fi
  env -i \
    "PATH=${PATH:-/usr/bin:/bin:/usr/sbin:/sbin}" \
    "HOME=${HOME:-/tmp}" \
    "MUSUW_ADMIN_PORT=$listen_port" \
    "MUSUW_ADMIN_PRODUCTION_SSH_TARGET=${MUSUW_ADMIN_PRODUCTION_SSH_TARGET:-}" \
    "MUSUW_ADMIN_PRODUCTION_TUNNEL_PORT=${MUSUW_ADMIN_PRODUCTION_TUNNEL_PORT:-}" \
    "MUSUW_ADMIN_PRODUCTION_DB_PORT=${MUSUW_ADMIN_PRODUCTION_DB_PORT:-}" \
    "MUSUW_ADMIN_PRODUCTION_CONTAINER=${MUSUW_ADMIN_PRODUCTION_CONTAINER:-}" \
    "$@"
}

launch_console_process() {
  launch_target=$1
  append_log=${2:-no}
  if [ "$append_log" != yes ]; then
    : > "$log_file"
  fi
  run_with_runtime_env "$launch_target" --replace-process nohup node "$server_script" "$launch_target" >>"$log_file" 2>&1 &
  launch_pid=$!
  printf '%s\n' "$launch_pid" > "$pid_file"
  printf '%s\n' "$launch_target" > "$target_file"
}

validate_target() {
  target=$1
  case "$target" in
    test)
      [ -r "$repo_root/.runtime/weknora/candidate.env" ] || die 'TEST runtime is missing .runtime/weknora/candidate.env'
      [ -r "$repo_root/.runtime/weknora/paddle-sandbox.env" ] || die 'TEST Paddle runtime is missing .runtime/weknora/paddle-sandbox.env'
      ;;
    production)
      [ "${MUSUW_ADMIN_PRODUCTION_UNLOCK:-}" = 'I_UNDERSTAND_THIS_IS_LIVE' ] || die 'production is locked; set MUSUW_ADMIN_PRODUCTION_UNLOCK=I_UNDERSTAND_THIS_IS_LIVE for this invocation'
      [ -r "$runtime_dir/production.env" ] || die 'production is not configured; create .runtime/musuw-admin/production.env first'
      ;;
    *) die "unknown environment: $target" ;;
  esac
}

restore_previous_target() {
  restore_target=$1
  case "$restore_target" in
    test) stop_tunnel ;;
    production)
      MUSUW_ADMIN_PRODUCTION_UNLOCK=I_UNDERSTAND_THIS_IS_LIVE prepare_production_tunnel || return 1
      ;;
    *) return 1 ;;
  esac
  launch_console_process "$restore_target" yes
  if wait_for_health; then
    return 0
  fi
  tail -n 20 "$log_file" >&2 2>/dev/null || true
  stop_server
  if [ "$restore_target" = production ]; then
    stop_tunnel
  fi
  return 1
}

start_console() {
  target=$1
  validate_target "$target"
  command -v node >/dev/null 2>&1 || die 'Node.js is required'
  command -v npm >/dev/null 2>&1 || die 'npm is required'
  command -v curl >/dev/null 2>&1 || die 'curl is required'

  previous_target=''
  if previous_pid=$(server_pid); then
    previous_target=$(sed -n '1p' "$target_file" 2>/dev/null || true)
    case "$previous_target" in
      test|production) : ;;
      *) previous_target='' ;;
    esac
  fi

  mkdir -p "$runtime_dir"
  run_with_runtime_env "$target" npm --prefix "$repo_root/weknora/frontend" run build-with-types

  # Prepare production before stopping the current console.  A failed SSH
  # handshake, host-key check, container lookup, or port forward therefore
  # leaves the current TEST process untouched.
  if [ "$target" = production ]; then
    prepare_production_tunnel
  else
    stop_tunnel
  fi

  stop_server
  retire_appsmith
  port_is_busy && die "port $listen_port is already in use"

  launch_console_process "$target"
  if ! wait_for_health; then
    tail -n 20 "$log_file" >&2 2>/dev/null || true
    stop_server
    if [ "$target" = production ]; then
      stop_tunnel
    fi
    if [ -n "$previous_target" ] && restore_previous_target "$previous_target"; then
      die "operations server did not become healthy; restored $previous_target"
    fi
    die 'operations server did not become healthy within 10 seconds'
  fi
  printf 'Musuw operations (%s): http://%s:%s\n' "$target" "$listen_host" "$listen_port"
}

show_status() {
  if ! pid=$(server_pid); then
    printf 'Musuw operations: stopped\n'
    printf 'SSH tunnel: %s\n' "$(tunnel_status)"
    return
  fi
  target=$(sed -n '1p' "$target_file" 2>/dev/null || printf 'unknown')
  health=$(curl --silent --max-time 1 "http://$listen_host:$listen_port/healthz" 2>/dev/null || printf '{"status":"unreachable"}')
  printf 'Musuw operations: target=%s pid=%s url=http://%s:%s health=%s\n' "$target" "$pid" "$listen_host" "$listen_port" "$health"
  printf 'SSH tunnel: %s\n' "$(tunnel_status)"
}

command=${1:-}
case "$command" in
  test|production) start_console "$command" ;;
  prepare-production-tunnel) prepare_production_tunnel ;;
  stop)
    mkdir -p "$runtime_dir"
    stop_server
    stop_tunnel
    printf 'Musuw operations: stopped (retired Appsmith data volume preserved)\n'
    ;;
  status) show_status ;;
  logs)
    [ -r "$log_file" ] || die 'no operations log exists'
    tail -n 100 "$log_file"
    ;;
  -h|--help|help|'') usage ;;
  *) usage >&2; exit 2 ;;
esac
